-- std.int — Integer utilities (Tier 1, no stdlib imports).
--
-- The arithmetic here is declared @primitive: addition is an operation of the
-- language, so the declaration gives it a name, a signature and documentation
-- and says nothing about how it is carried out. Every backend supplies that
-- itself.
--
-- The rest is ordinary: @ffi wrappers name a function of the host runtime, and
-- pure Ridge functions have a body like any other.
--
-- Int is a 64-bit signed integer, holding -9223372036854775808 to
-- 9223372036854775807. An operation whose result would leave that range
-- raises rather than silently wrapping, so a value of type Int is always a
-- value the type can hold. wrappingAdd and saturatingAdd are the explicit
-- opt-outs for code that wants a defined answer at the boundary instead.

-- Convert an integer to its decimal text representation.
@ffi("erlang", "integer_to_binary", 1)
pub fn toText (n: Int) -> Text

-- Parse a text string as a decimal integer.
-- Answers None for text that is not a number and for a number outside
-- Int's range — a value the type cannot hold is not a successful parse.
@ffi("ridge_rt", "int_parse", 1)
pub fn parse (s: Text) -> Option Int

-- Absolute value. Raises for the smallest Int: the range reaches one
-- further below zero than above it, so that one value has no positive
-- counterpart inside the type.
@ffi("ridge_rt", "int_abs", 1)
pub fn abs (n: Int) -> Int

-- Smaller of two integers.
pub fn min (a: Int) (b: Int) -> Int =
    if a <= b then a else b

-- Larger of two integers.
pub fn max (a: Int) (b: Int) -> Int =
    if a >= b then a else b

-- Addition. Raises when the result would leave the range of `Int`.
@primitive
pub fn add (a: Int) (b: Int) -> Int

-- Subtraction. Raises when the result would leave the range of `Int`.
@primitive
pub fn sub (a: Int) (b: Int) -> Int

-- Multiplication. Raises when the result would leave the range of `Int`.
@primitive
pub fn mul (a: Int) (b: Int) -> Int

-- Integer division, truncating toward zero. Raises when `b` is zero, and for
-- the one division that leaves the range: the smallest `Int` over -1 is one
-- past the largest.
@primitive
pub fn div (a: Int) (b: Int) -> Int

-- Truncating remainder. Result has the same sign as the dividend `a`, and
-- satisfies `a == b * (a div b) + (a rem b)`. Raises when `b` is zero.
--
-- Unlike the rest of the arithmetic here, this one cannot leave the range: a
-- remainder is smaller in magnitude than its divisor. Even the case that
-- catches `div` is fine — the smallest `Int` remainder -1 is 0.
@primitive
pub fn rem (a: Int) (b: Int) -> Int

-- Mathematical modulo (Python `%` semantics).
-- Result has the same sign as the divisor `b` and lies in
-- `[0, |b|)` when `b` is positive, or `(b, 0]` when `b` is negative.
-- Compiler lowering of the `%` operator routes here.
--
-- The remainder already is the answer whenever it agrees in sign with the
-- divisor; otherwise one divisor away from it is. Written this way rather
-- than as `((a rem b) + b) rem b` because that form adds two values that can
-- agree in sign, and for a large enough divisor the sum leaves the range and
-- the whole thing raises on inputs it used to answer.
pub fn mod (a: Int) (b: Int) -> Int =
    let r = rem a b
    if r == 0 || (r < 0) == (b < 0) then r
    else r + b

-- Negate an integer. Raises for the smallest `Int`, which has no positive
-- counterpart inside the type — the same asymmetry that makes `abs` partial.
@primitive
pub fn neg (n: Int) -> Int

-- Integer power: `base` raised to a non-negative integer `exp`.
-- Implemented via repeated squaring. The compiler lowering of the `^`
-- operator routes here. Raises when the result leaves the range of `Int`,
-- which for a base above 1 happens quickly.
--
-- Conventions:
-- - `pow n 0` returns `1` for every `n` (including `0`).
-- - `pow 0 k` returns `0` for `k > 0`.
-- - Negative exponents yield `0` (truncating semantics — Ridge's `Int` model
--   cannot represent fractions; use `std.float.pow` instead for `Float`).
pub fn pow (base: Int) (exp: Int) -> Int =
    if exp < 0 then 0
    else if exp == 0 then 1
    else if rem exp 2 == 0 then
        let half = pow base (div exp 2)
        half * half
    else base * pow base (exp - 1)

-- Wrapping addition — the result is what a 64-bit register would hold, so
-- `wrappingAdd maxValue 1` is the smallest `Int` rather than a failure. This
-- is the explicit opt-out from the rule that `+` raises at the boundary.
--
-- Every step below stays inside the range, on purpose: the overflow is
-- predicted from the operands rather than produced and then folded back.
-- Producing it first is what the old implementation did, and under a `+` that
-- raises it never reaches the fold. It also means this function no longer
-- depends on the host having arbitrary-precision integers, so it says the
-- same thing on a backend whose integers are 64 bits wide.
--
-- `minVal` is built rather than written because `Int` reaches one further
-- below zero than above it, so the smallest value has no literal.
pub fn wrappingAdd (a: Int) (b: Int) -> Int =
    let maxVal = 9223372036854775807
    let minVal = 0 - maxVal - 1
    if b >= 0 then
        -- Wraps exactly when `a + b` would pass the top; the wrapped value is
        -- `a + b - 2^64`, and both halves of that are inside the range.
        if a > maxVal - b then (a - maxVal - 1) + (b - maxVal - 1)
        else a + b
    else
        if a < minVal - b then (a - minVal) + (b - minVal)
        else a + b

-- Saturating addition — the result is clamped to the ends of `Int` instead of
-- raising. The other explicit opt-out; use it when a bounded answer is more
-- useful than a failure.
pub fn saturatingAdd (a: Int) (b: Int) -> Int =
    let maxVal = 9223372036854775807
    let minVal = 0 - maxVal - 1
    if b >= 0 then
        if a > maxVal - b then maxVal else a + b
    else
        if a < minVal - b then minVal else a + b
