-- expect-clean
-- A terminate callback that declares the capability its body uses checks
-- cleanly. A handler declares it here too, which is fine but is not what
-- makes it legal — cap_terminate_declares_own_capability_clean is the same
-- callback with nothing sharing it. The reason param matches over
-- ExitReason's variants;
-- NotRunning never reaches terminate (it only comes from monitoring an
-- already-dead process) but the match must still cover it.
import std.io as Io
import std.actor (ExitReason, Normal, NotRunning, Shutdown, Crashed)

actor Worker =
    state n: Int = 0
    on io tick =
        n <- n + 1
        Io.println "tick"
    terminate io (reason: ExitReason) =
        match reason
            Normal -> Io.println "normal"
            NotRunning -> Io.println "unreachable"
            Shutdown -> Io.println "clean"
            Crashed m -> Io.println m
