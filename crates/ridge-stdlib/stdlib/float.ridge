-- std.float — Floating-point utilities (Tier 1, no stdlib imports).
--
-- Direct @ffi wrappers delegate to BEAM erlang:*, math:*, ridge_rt:*, erts_internal:*.
-- Hybrid functions combine a raw @ffi with a Ridge wrapper.
--
-- Float uses double precision; the current runtime accepts finite values only.
-- Named numerical comparisons treat positive and negative zero as equal.
-- totalCompare is a separate total ordering, including distinct signed zeros.

-- Exact numerical equality, with no implicit tolerance or type conversion.
@ffi("ridge_rt", "float_equal", 2)
pub fn equal (a: Float) (b: Float) -> Bool

-- Numerical ordering predicates. These share equal's numerical zero behavior.
@ffi("ridge_rt", "float_less", 2)
pub fn less (a: Float) (b: Float) -> Bool

@ffi("ridge_rt", "float_less_or_equal", 2)
pub fn lessOrEqual (a: Float) (b: Float) -> Bool

@ffi("ridge_rt", "float_greater", 2)
pub fn greater (a: Float) (b: Float) -> Bool

@ffi("ridge_rt", "float_greater_or_equal", 2)
pub fn greaterOrEqual (a: Float) (b: Float) -> Bool

-- Convert a float to its text representation.
@ffi("ridge_rt", "float_to_text", 1)
pub fn toText (f: Float) -> Text

-- Raw BEAM binary_to_float — strict: throws on any input that lacks a
-- decimal point or exponent (e.g. "100"). Kept for callers that need the
-- raw BEAM semantics; for general use prefer `parse`.
@ffi("erlang", "binary_to_float", 1)
pub fn parseStrict (s: Text) -> Float

-- Parse a text string as a float. Accepts both float-shaped strings
-- ("3.14", "1e3") and integer-shaped strings ("100"). Returns None when
-- the input is not a valid number.
@ffi("ridge_rt", "float_parse", 1)
pub fn parse (s: Text) -> Option Float

-- Convert an integer to a float.
@ffi("erlang", "float", 1)
pub fn fromInt (n: Int) -> Float

-- Round to the nearest integer; a half rounds away from zero.
-- Raises when the result is outside Int's range, which a large enough
-- Float will be: Float reaches far past what Int can hold.
@ffi("ridge_rt", "int_round", 1)
pub fn round (f: Float) -> Int

-- Truncate toward zero. Raises when the result is outside Int's range.
@ffi("ridge_rt", "int_trunc", 1)
pub fn truncate (f: Float) -> Int

-- Floor: greatest integer <= f.
-- BEAM erlang:trunc/1 rounds toward zero, so for negatives we subtract 1
-- unless f is exactly an integer.
pub fn floor (f: Float) -> Int =
    let t = truncate f
    if greaterOrEqual f 0.0 then t
    else
        let ft = fromInt t
        if equal ft f then t else t - 1

-- Ceiling: smallest integer >= f.
-- Symmetric with floor: for positives, add 1 unless f is exactly an integer.
pub fn ceil (f: Float) -> Int =
    let t = truncate f
    if lessOrEqual f 0.0 then t
    else
        let ft = fromInt t
        if equal ft f then t else t + 1

-- Square root.
@ffi("math", "sqrt", 1)
pub fn sqrt (f: Float) -> Float

-- Absolute value.
@ffi("erlang", "abs", 1)
pub fn abs (f: Float) -> Float

-- Smaller of two floats.
pub fn min (a: Float) (b: Float) -> Float =
    if lessOrEqual a b then a else b

-- Larger of two floats.
pub fn max (a: Float) (b: Float) -> Float =
    if greaterOrEqual a b then a else b

-- Raise `base` to the power `exp` (IEEE 754 double), via BEAM math:pow/2.
-- For an integer base and exponent that must stay exact, use `std.int.pow`.
@ffi("math", "pow", 2)
pub fn pow (base: Float) (exp: Float) -> Float

-- Addition.
@primitive
pub fn add (a: Float) (b: Float) -> Float

-- Subtraction.
@primitive
pub fn sub (a: Float) (b: Float) -> Float

-- Multiplication.
@primitive
pub fn mul (a: Float) (b: Float) -> Float

-- Division. Raises when `b` is zero rather than answering an infinity.
@primitive
pub fn div (a: Float) (b: Float) -> Float

-- Negate a float.
@primitive
pub fn neg (f: Float) -> Float

-- Total ordering of representable floats, distinguishing signed zeros.
-- Returns a negative, zero, or positive Int according to that ordering.
-- Use equal/less/greater and their inclusive forms for numerical comparison.
@ffi("erts_internal", "cmp_term", 2)
pub fn totalCompare (a: Float) (b: Float) -> Int
