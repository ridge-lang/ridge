{
  "Function (pure)": {
    "prefix": "fn",
    "body": [
      "fn ${1:name} (${2:param}: ${3:Type}) -> ${4:Type} =",
      "    ${0:body}"
    ],
    "description": "Pure function"
  },
  "Function with capability": {
    "prefix": "fnc",
    "body": [
      "fn ${1|io,fs,net,time,random,env,proc,spawn,ffi,db|} ${2:name} (${3:param}: ${4:Type}) -> ${5:Type} =",
      "    ${0:body}"
    ],
    "description": "Function requiring an effect capability (choice list)"
  },
  "Main (entry point)": {
    "prefix": "main",
    "body": [
      "pub fn io main () -> Unit =",
      "    ${0:body}"
    ],
    "description": "Application entry point"
  },
  "let binding": {
    "prefix": "let",
    "body": "let ${1:name} = ${2:value}",
    "description": "Immutable local binding"
  },
  "const": {
    "prefix": "const",
    "body": "const ${1:name}: ${2:Type} = ${3:value}",
    "description": "Top-level constant"
  },
  "var (mutable)": {
    "prefix": "var",
    "body": "var ${1:name} = ${2:initial}",
    "description": "Mutable binding (assign with <-)"
  },
  "Type alias": {
    "prefix": "typea",
    "body": "type ${1:Name} = ${2:ExistingType}",
    "description": "Transparent type alias"
  },
  "Union type": {
    "prefix": "typeu",
    "body": [
      "type ${1:Name} =",
      "    | ${2:First}",
      "    | ${3:Second} { ${4:field}: ${5:Type} }"
    ],
    "description": "Union (sum) type with constructors"
  },
  "Record type": {
    "prefix": "typer",
    "body": "type ${1:Name} = { ${2:field}: ${3:Type}, ${4:field2}: ${5:Type} } deriving (${6|Eq,ToText,Ord,Encode,Decode|})",
    "description": "Record type with deriving"
  },
  "Opaque type": {
    "prefix": "typeo",
    "body": "pub opaque type ${1:Name} = { ${2:field}: ${3:Type} }",
    "description": "Opaque type (representation hidden)"
  },
  "Import module": {
    "prefix": "import",
    "body": "import ${1:std.list} as ${2:List}",
    "description": "Module import, qualified"
  },
  "Import selective": {
    "prefix": "imports",
    "body": "import ${1:std.test} (${2:ensure, assertEq})",
    "description": "Selective import of names"
  },
  "Import qualified + selective": {
    "prefix": "importq",
    "body": "import ${1:std.net.http} as ${2:Http} (${3:get, post})",
    "description": "Qualified import with selective names"
  },
  "if / then / else": {
    "prefix": "if",
    "body": [
      "if ${1:cond} then ${2:value}",
      "else ${3:value}"
    ],
    "description": "If expression (else-if chains with 'else if')"
  },
  "match expression": {
    "prefix": "match",
    "body": [
      "match ${1:scrutinee}",
      "    ${2:Pattern} -> ${3:result}",
      "    ${4:_}       -> ${5:fallback}"
    ],
    "description": "Match expression with cases"
  },
  "match with guard": {
    "prefix": "matchg",
    "body": [
      "match ${1:scrutinee}",
      "    ${2:Pattern} when ${3:cond} -> ${4:result}",
      "    ${5:_}                      -> ${6:fallback}"
    ],
    "description": "Match expression with a when guard"
  },
  "guard": {
    "prefix": "guard",
    "body": "guard ${1:cond} else return ${2:fallback}",
    "description": "Guard clause (early return)"
  },
  "try block": {
    "prefix": "try",
    "body": [
      "try",
      "    let ${1:x} = ${2:fallible} ?",
      "    ${0:Ok ()}"
    ],
    "description": "Try block with ? propagation"
  },
  "Record update (with)": {
    "prefix": "with",
    "body": "${1:record} with { ${2:field} = ${3:value} }",
    "description": "Record update expression"
  },
  "Lambda": {
    "prefix": "lam",
    "body": "fn (${1:x}: ${2:Type}) -> ${0:body}",
    "description": "Anonymous function"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} ${2:a} =",
      "    ${3:method} (x: ${2:a}) -> ${4:Type}"
    ],
    "description": "Type class declaration"
  },
  "Instance": {
    "prefix": "instance",
    "body": [
      "instance ${1:Name} ${2:Type} =",
      "    ${3:method} (${4:x}: ${2:Type}) -> ${5:Type} = ${0:body}"
    ],
    "description": "Type class instance"
  },
  "Class with functional dependency": {
    "prefix": "classfd",
    "body": [
      "class ${1:Name} ${2:q} ${3:p} | ${2:q} -> ${3:p} =",
      "    ${4:method} (x: ${2:q}) -> ${5:Type}"
    ],
    "description": "Type class with a functional dependency"
  },
  "Constrained function (where)": {
    "prefix": "fnw",
    "body": [
      "fn ${1:name} (${2:param}: ${3:a}) -> ${4:Type} where ${5:Class} ${3:a} =",
      "    ${0:body}"
    ],
    "description": "Function with a class constraint (where clause)"
  },
  "Actor skeleton": {
    "prefix": "actor",
    "body": [
      "actor ${1:Counter} =",
      "    state ${2:count}: ${3:Int} = ${4:0}",
      "",
      "    init (${5:initial}: ${3:Int}) =",
      "        ${2:count} <- ${5:initial}",
      "",
      "    on ${6:increment} =",
      "        ${2:count} <- ${2:count} + 1"
    ],
    "description": "Actor with state, init, and a message handler"
  },
  "Message handler (on)": {
    "prefix": "on",
    "body": [
      "on ${1:message} (${2:param}: ${3:Type}) =",
      "    ${0:body}"
    ],
    "description": "Fire-and-forget message handler"
  },
  "Ask handler (on with reply)": {
    "prefix": "onr",
    "body": [
      "on ${1:get} -> ${2:Int} =",
      "    ${0:state}"
    ],
    "description": "Message handler that replies (ask with ?>)"
  },
  "terminate callback": {
    "prefix": "terminate",
    "body": [
      "terminate (${1:reason}: ExitReason) =",
      "    ${0:()}"
    ],
    "description": "Actor terminate callback"
  },
  "onDown monitor callback": {
    "prefix": "ondown",
    "body": [
      "onDown (${1:m}: Monitor) (${2:reason}: ExitReason) =",
      "    ${0:()}"
    ],
    "description": "Monitor DOWN callback"
  },
  "spawn + send": {
    "prefix": "spawn",
    "body": [
      "let ${1:c} = spawn ${2:Actor} ${3:args}",
      "${1:c} ! ${4:message}"
    ],
    "description": "Spawn an actor and send a message (ask with ?>)"
  },
  "Supervisor with children": {
    "prefix": "supervise",
    "body": "let ${1:sup} = Actor.supervise ${2:OneForOne} ${3:3} ${4:5000} [child ${5:Counter} (${6:0})]?",
    "description": "Supervisor with a child spec"
  },
  "@test": {
    "prefix": "test",
    "body": [
      "@test \"${1:description}\"",
      "fn ${2:name} () -> Result Unit Text =",
      "    ${0:Ok ()}"
    ],
    "description": "Unit test"
  },
  "@test with assertions": {
    "prefix": "testa",
    "body": [
      "@test \"${1:description}\"",
      "fn ${2:name} () -> Result Unit Text =",
      "    ensure (${3:cond}) \"${4:message}\" ?",
      "    assertEq (${5:actual}) (${6:expected}) \"${7:label}\" ?",
      "    Ok ()"
    ],
    "description": "Unit test with ensure/assertEq (import std.test)"
  },
  "List.map": {
    "prefix": "lmap",
    "body": "List.map (fn (${1:x}: ${2:a}) -> ${3:body}) ${4:xs}",
    "description": "Map over a list"
  },
  "List.fold": {
    "prefix": "lfold",
    "body": "List.fold (fn (${1:acc}: ${2:b}) (${3:x}: ${4:a}) -> ${5:body}) ${6:init} ${7:xs}",
    "description": "Fold a list"
  },
  "List.forEach": {
    "prefix": "foreach",
    "body": "${1:xs} |> List.forEach (fn ${2:x} -> ${0:body})",
    "description": "Iterate a list for effects"
  },
  "Option.withDefault": {
    "prefix": "optdef",
    "body": "Option.withDefault ${1:default} ${2:option}",
    "description": "Unwrap an Option with a default"
  },
  "Result.mapErr": {
    "prefix": "maperr",
    "body": "Result.mapErr (fn (${1:e}: ${2:e2}) -> ${3:body}) ${4:result}",
    "description": "Map the error channel of a Result"
  },
  "Repo query pipeline": {
    "prefix": "repoquery",
    "body": [
      "${1:users}",
      "    |> Repo.query",
      "    |> Repo.filter (fn (${2:u}: ${3:User}) -> ${4:cond})",
      "    |> Repo.orderBy ${5|Asc,Desc|} (fn (${2:u}: ${3:User}) -> ${6:key})",
      "    |> Repo.limit ${7:20}",
      "    |> Repo.toList"
    ],
    "description": "Repository query pipeline (filter/order/page/fetch)"
  },
  "Repo.insert": {
    "prefix": "repoinsert",
    "body": "${1:users} |> Repo.insert (${2:User} { ${3:id} = ${4:1} })",
    "description": "Insert a typed entity"
  },
  "Repo.setWhere": {
    "prefix": "reposetwhere",
    "body": "${1:users} |> Repo.setWhere [Repo.set (fn (${2:u}: ${3:User}) -> ${4:column}) ${5:value}] (fn (${2:u}: ${3:User}) -> ${6:cond})",
    "description": "Partial typed update with predicate"
  }
}
