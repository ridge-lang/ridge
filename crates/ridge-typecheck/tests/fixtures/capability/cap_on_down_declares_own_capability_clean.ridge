-- expect-clean
-- An onDown handler declares the capability its body needs, and no `on`
-- handler declares it. Reporting that a watched process died is the handler's
-- whole job, so its own declaration is what puts the capability in the actor's
-- set.
--
-- Unlike its terminate twin, this fixture also passed before onDown joined the
-- set: the check never read `on_down_caps`, though the rule was written down.
-- It guards the rule now that it is real rather than proving a fix.
import std.io as Io
import std.actor as Actor
import std.actor (ExitReason, Normal, NotRunning, Shutdown, Crashed)

actor Worker =
    state n: Int = 0
    on explode (x: Int) -> Unit =
        n <- 1 / x

actor Watcher =
    state deaths: Int = 0
    on watch (w: Handle Worker) -> Unit =
        let _ = Actor.monitor w
    onDown io (m: Monitor) (reason: ExitReason) =
        match reason
            Normal -> Io.println "normal"
            NotRunning -> Io.println "gone"
            Shutdown -> Io.println "stopped"
            Crashed t -> Io.println t
