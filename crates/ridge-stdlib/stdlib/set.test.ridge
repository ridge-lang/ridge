-- Exercise the public collection implementation; keep the behavioral oracles below.
fn _fromList (xs: List a) -> Set a where Hash a = Set.fromList xs
fn _toList (s: Set a) -> List a = Set.toList s
fn _insert (x: a) (s: Set a) -> Set a where Hash a = Set.insert x s
fn _remove (x: a) (s: Set a) -> Set a where Hash a = Set.remove x s
fn _contains (x: a) (s: Set a) -> Bool where Hash a = Set.contains x s
fn _union (a: Set x) (b: Set x) -> Set x where Hash x = Set.union a b
fn _length (s: Set a) -> Int = Set.length s
fn _intersection (a: Set x) (b: Set x) -> Set x where Hash x = Set.intersection a b
fn _difference (a: Set x) (b: Set x) -> Set x where Hash x = Set.difference a b

@ffi("erlang", "length", 1)
fn _listLength (xs: List a) -> Int

@test "smoke_set"
pub fn test_smoke_set () -> Result Unit Text = Ok ()

@test "empty_size_zero"
pub fn test_empty_size_zero () -> Result Unit Text =
    if _length Set.empty == 0 then Ok ()
    else Err "Set.empty length should be 0"

@test "fromList_dedups"
pub fn test_fromList_dedups () -> Result Unit Text =
    if _length (_fromList [1, 2, 1, 2]) == 2 then Ok ()
    else Err "Set.fromList [1,2,1,2] should deduplicate to length 2"

@test "insert_then_contains"
pub fn test_insert_then_contains () -> Result Unit Text =
    if _contains 5 (_insert 5 Set.empty) then Ok ()
    else Err "Set.insert 5 then contains should be true"

@test "remove_then_contains_false"
pub fn test_remove_then_contains_false () -> Result Unit Text =
    if _contains 5 (_remove 5 (_insert 5 Set.empty)) then Err "Set.remove 5 should make contains false"
    else Ok ()

@test "union_combines"
pub fn test_union_combines () -> Result Unit Text =
    if _length (_union (_fromList [1, 2]) (_fromList [2, 3])) == 3 then Ok ()
    else Err "Set.union [1,2] [2,3] should have length 3"

@test "intersection_overlap"
pub fn test_intersection_overlap () -> Result Unit Text =
    if _length (_intersection (_fromList [1, 2]) (_fromList [2, 3])) == 1 then Ok ()
    else Err "Set.intersection [1,2] [2,3] should have length 1"

@test "difference_excludes"
pub fn test_difference_excludes () -> Result Unit Text =
    if _contains 1 (_difference (_fromList [1, 2]) (_fromList [2, 3])) then Ok ()
    else Err "Set.difference [1,2] [2,3] should contain 1"

@test "toList_round_trips_count"
pub fn test_toList_round_trips_count () -> Result Unit Text =
    if _listLength (_toList (_fromList [1, 2, 3])) == 3 then Ok ()
    else Err "Set.toList fromList [1,2,3] should have length 3"
