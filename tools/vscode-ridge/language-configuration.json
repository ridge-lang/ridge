{
  "comments": {
    "lineComment": "--"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["comment"] },
    { "open": "\"\"\"", "close": "\"\"\"", "notIn": ["string", "comment"] },
    { "open": "r#\"", "close": "\"#", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([A-Za-z_][A-Za-z0-9_]*)",
  "folding": {
    "offSide": true
  },
  "indentationRules": {
    "increaseIndentPattern": "(^|[^=!<>])=\\s*(--.*)?$|(->|<-)\\s*(--.*)?$|\\b(then|else|try)\\b\\s*(--.*)?$|(^|=)\\s*match\\b[^>]*$|\\|>\\s*(--.*)?$",
    "decreaseIndentPattern": "^\\s*else\\s*(--.*)?$"
  }
}
