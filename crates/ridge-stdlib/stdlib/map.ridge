-- std.map -- persistent key-value collections (Tier 2).
-- Key operations use Hash and its Eq superclass. Values need no equality.
-- Equivalent keys retain the first stored representative and latest value.
-- Traversal order is unspecified; callbacks retain capability transparency.

opaque type KeyEvidence k = {}

@primitive
fn _keyEvidence () -> KeyEvidence k where Eq k, Hash k

@ffi("ridge_rt", "indexed_map_empty", 0)
fn _empty () -> Map k v

pub fn empty -> Map k v = _empty ()

@ffi("ridge_rt", "indexed_map_from_list", 2)
fn _fromList (evidence: KeyEvidence k) (xs: List (k, v)) -> Map k v

-- Construct a map, keeping the last value for each equivalent key.
pub fn fromList (xs: List (k, v)) -> Map k v where Hash k = _fromList (_keyEvidence ()) xs

@ffi("ridge_rt", "indexed_map_to_list", 1)
pub fn toList (m: Map k v) -> List (k, v)

@ffi("ridge_rt", "indexed_map_insert", 4)
fn _insert (evidence: KeyEvidence k) (k: k) (v: v) (m: Map k v) -> Map k v

-- Insert or replace a value without replacing an equivalent stored key.
pub fn insert (k: k) (v: v) (m: Map k v) -> Map k v where Hash k = _insert (_keyEvidence ()) k v m

@ffi("ridge_rt", "indexed_map_remove", 3)
fn _remove (evidence: KeyEvidence k) (k: k) (m: Map k v) -> Map k v

pub fn remove (k: k) (m: Map k v) -> Map k v where Hash k = _remove (_keyEvidence ()) k m

@ffi("ridge_rt", "indexed_map_get", 3)
fn _get (evidence: KeyEvidence k) (k: k) (m: Map k v) -> Option v

pub fn get (k: k) (m: Map k v) -> Option v where Hash k = _get (_keyEvidence ()) k m

@ffi("ridge_rt", "indexed_map_contains", 3)
fn _contains (evidence: KeyEvidence k) (k: k) (m: Map k v) -> Bool

pub fn contains (k: k) (m: Map k v) -> Bool where Hash k = _contains (_keyEvidence ()) k m

@ffi("ridge_rt", "indexed_map_keys", 1)
pub fn keys (m: Map k v) -> List k

@ffi("ridge_rt", "indexed_map_values", 1)
pub fn values (m: Map k v) -> List v

-- Transform values while preserving the keys and their index.
@ffi("ridge_rt", "indexed_map_map", 2)
pub fn map (f: fn k v -> w) (m: Map k v) -> Map k w

@ffi("ridge_rt", "indexed_map_filter", 2)
pub fn filter (p: fn k v -> Bool) (m: Map k v) -> Map k v

@ffi("ridge_rt", "indexed_map_size", 1)
pub fn length (m: Map k v) -> Int

@ffi("ridge_rt", "indexed_map_merge", 3)
fn _merge (evidence: KeyEvidence k) (a: Map k v) (b: Map k v) -> Map k v

-- Right-side values take priority; equivalent left-side keys are retained.
pub fn merge (a: Map k v) (b: Map k v) -> Map k v where Hash k = _merge (_keyEvidence ()) a b

@ffi("ridge_rt", "indexed_map_update", 4)
fn _update (evidence: KeyEvidence k) (k: k) (f: fn (Option v) -> v) (m: Map k v) -> Map k v

-- The callback receives None for an absent key and returns the new value.
pub fn update (k: k) (f: fn (Option v) -> v) (m: Map k v) -> Map k v where Hash k =
    _update (_keyEvidence ()) k f m

@ffi("ridge_rt", "indexed_map_filter_map", 2)
pub fn filterMap (f: fn k v -> Option w) (m: Map k v) -> Map k w
