-- expect: T003
-- `Actor.send` takes exactly two arguments — the handle and the message —
-- so a third argument is an arity error (payload belongs inside the
-- parenthesised message: `Actor.send c (increment 5)`).
import std.actor as Actor

actor Counter =
    state count: Int = 0
    on increment =
        count <- count + 1

fn spawn main () -> Unit =
    let c = spawn Counter
    let _ = Actor.send c increment 5
    ()
