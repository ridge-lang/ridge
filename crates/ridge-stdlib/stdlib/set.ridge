-- std.set -- persistent sets (Tier 2).
-- Equivalent elements retain the first stored representative.
-- Private bridges avoid an import cycle with std.map.

opaque type KeyEvidence k = {}

@primitive
fn _keyEvidence () -> KeyEvidence k where Eq k, Hash k

@ffi("ridge_rt", "indexed_map_empty", 0)
fn _empty () -> Set a

pub fn empty -> Set a = _empty ()

@ffi("ridge_rt", "indexed_set_from_list", 2)
fn _fromList (evidence: KeyEvidence a) (xs: List a) -> Set a

pub fn fromList (xs: List a) -> Set a where Hash a = _fromList (_keyEvidence ()) xs

@ffi("ridge_rt", "indexed_map_keys", 1)
pub fn toList (s: Set a) -> List a

@ffi("ridge_rt", "indexed_map_insert", 4)
fn _insert (evidence: KeyEvidence a) (x: a) (present: Bool) (s: Set a) -> Set a

pub fn insert (x: a) (s: Set a) -> Set a where Hash a = _insert (_keyEvidence ()) x true s

@ffi("ridge_rt", "indexed_map_remove", 3)
fn _remove (evidence: KeyEvidence a) (x: a) (s: Set a) -> Set a

pub fn remove (x: a) (s: Set a) -> Set a where Hash a = _remove (_keyEvidence ()) x s

@ffi("ridge_rt", "indexed_map_contains", 3)
fn _contains (evidence: KeyEvidence a) (x: a) (s: Set a) -> Bool

pub fn contains (x: a) (s: Set a) -> Bool where Hash a = _contains (_keyEvidence ()) x s

@ffi("ridge_rt", "indexed_map_merge", 3)
fn _union (evidence: KeyEvidence a) (left: Set a) (right: Set a) -> Set a

pub fn union (left: Set a) (right: Set a) -> Set a where Hash a = _union (_keyEvidence ()) left right

@ffi("ridge_rt", "indexed_set_intersection", 3)
fn _intersection (evidence: KeyEvidence a) (left: Set a) (right: Set a) -> Set a

pub fn intersection (left: Set a) (right: Set a) -> Set a where Hash a = _intersection (_keyEvidence ()) left right

@ffi("ridge_rt", "indexed_set_difference", 3)
fn _difference (evidence: KeyEvidence a) (left: Set a) (right: Set a) -> Set a

pub fn difference (left: Set a) (right: Set a) -> Set a where Hash a = _difference (_keyEvidence ()) left right

@ffi("ridge_rt", "indexed_map_size", 1)
pub fn length (s: Set a) -> Int
