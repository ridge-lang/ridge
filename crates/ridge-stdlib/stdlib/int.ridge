-- std.int — Integer utilities (Tier 1, no stdlib imports).
--
-- The arithmetic here is declared @primitive: addition is an operation of the
-- language, so the declaration gives it a name, a signature and documentation
-- and says nothing about how it is carried out. Every backend supplies that
-- itself.
--
-- The rest is ordinary: @ffi wrappers name a function of the host runtime, and
-- pure Ridge functions have a body like any other.
--
-- Int is fixed 64-bit signed in the Ridge model.
-- wrappingAdd / saturatingAdd provided for overflow-safe arithmetic.

-- Convert an integer to its decimal text representation.
@ffi("erlang", "integer_to_binary", 1)
pub fn toText (n: Int) -> Text

-- Parse a text string as a decimal integer.
-- Answers None for text that is not a number and for a number outside
-- Int's range — a value the type cannot hold is not a successful parse.
@ffi("ridge_rt", "int_parse", 1)
pub fn parse (s: Text) -> Option Int

-- Absolute value. Raises for the smallest Int: the range reaches one
-- further below zero than above it, so that one value has no positive
-- counterpart inside the type.
@ffi("ridge_rt", "int_abs", 1)
pub fn abs (n: Int) -> Int

-- Smaller of two integers.
pub fn min (a: Int) (b: Int) -> Int =
    if a <= b then a else b

-- Larger of two integers.
pub fn max (a: Int) (b: Int) -> Int =
    if a >= b then a else b

-- Addition.
@primitive
pub fn add (a: Int) (b: Int) -> Int

-- Subtraction.
@primitive
pub fn sub (a: Int) (b: Int) -> Int

-- Multiplication.
@primitive
pub fn mul (a: Int) (b: Int) -> Int

-- Integer division, truncating toward zero. Raises when `b` is zero.
@primitive
pub fn div (a: Int) (b: Int) -> Int

-- Truncating remainder. Result has the same sign as the dividend `a`, and
-- satisfies `a == b * (a div b) + (a rem b)`. Raises when `b` is zero.
@primitive
pub fn rem (a: Int) (b: Int) -> Int

-- Mathematical modulo (Python `%` semantics).
-- Result has the same sign as the divisor `b` and lies in
-- `[0, |b|)` when `b` is positive, or `(b, 0]` when `b` is negative.
-- Implemented via `((a rem b) + b) rem b`; correct for every combination
-- of signs of `a` and `b`. Compiler lowering of the `%` operator routes
-- here.
pub fn mod (a: Int) (b: Int) -> Int =
    let r = rem a b
    rem (r + b) b

-- Negate an integer.
@primitive
pub fn neg (n: Int) -> Int

-- Integer power: `base` raised to a non-negative integer `exp`.
-- Implemented via repeated squaring so the result is exact even for large
-- exponents. The compiler lowering of the `^` operator routes here.
--
-- Conventions:
-- - `pow n 0` returns `1` for every `n` (including `0`).
-- - `pow 0 k` returns `0` for `k > 0`.
-- - Negative exponents yield `0` (truncating semantics — Ridge's `Int` model
--   cannot represent fractions; use `std.float.pow` instead for `Float`).
pub fn pow (base: Int) (exp: Int) -> Int =
    if exp < 0 then 0
    else if exp == 0 then 1
    else if rem exp 2 == 0 then
        let half = pow base (div exp 2)
        half * half
    else base * pow base (exp - 1)

-- Wrapping addition — result is masked to the 64-bit signed range.
-- Erlang integers are arbitrary-precision, so we simulate 64-bit wrap
-- by subtracting / adding the 64-bit modulus when the result overflows.
-- This function is the safe alternative to plain add for code that
-- must not crash on overflow.
pub fn wrappingAdd (a: Int) (b: Int) -> Int =
    let s = a + b
    let maxVal = 9223372036854775807
    -- Written as arithmetic rather than as literals: `Int` holds the 64-bit
    -- signed range, so neither `-9223372036854775808` (whose positive half is
    -- one past the maximum) nor 2^64 can be spelled directly. The values are
    -- built at runtime, where integers are arbitrary-precision.
    let minVal = 0 - maxVal - 1
    let modulus = (maxVal + 1) * 2
    if s > maxVal then s - modulus
    else if s < minVal then s + modulus
    else s

-- Saturating addition — result is clamped to [Int64.min, Int64.max].
-- Use this when you want a bounded result instead of wrapping.
pub fn saturatingAdd (a: Int) (b: Int) -> Int =
    let s = a + b
    let maxVal = 9223372036854775807
    let minVal = 0 - maxVal - 1
    if s > maxVal then maxVal
    else if s < minVal then minVal
    else s
